# FinAlly environment configuration
# Copy this file to .env (never commit .env) and fill in your values.

# Required for AI chat: OpenRouter API key (https://openrouter.ai/keys).
# If missing (and LLM_MOCK is not true), chat replies with a friendly error; the rest of the app still works.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (E2E tests, no API key needed).
LLM_MOCK=false

# Optional: LLM model (LiteLLM id). Default: openrouter/openai/gpt-oss-120b
# Free (rate-limited, slower) alternative: openrouter/nvidia/nemotron-3.5-super-vl:free
LLM_MODEL=

# Optional: OpenRouter inference provider to pin. Leave unset for the default (cerebras).
# Set to "any" to let OpenRouter choose; required for ":free" models, which Cerebras doesn't serve.
# LLM_PROVIDER=any
